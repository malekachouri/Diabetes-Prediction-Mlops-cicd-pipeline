# ==========================================================
#  Local environment variables (template)
#  1. Copy this file:   cp .env.example .env
#  2. Fill in .env with your own values (.env is git-ignored)
#  3. Load it in your shell:   set -a && source .env && set +a
# ==========================================================

# MLflow tracking server hosted by DagsHub
MLFLOW_TRACKING_URI="https://dagshub.com/your-dagshub-user/Diabetes-Prediction-Mlops-cicd-pipeline.mlflow"
MLFLOW_TRACKING_USERNAME="your-dagshub-user"
MLFLOW_TRACKING_PASSWORD="your-dagshub-token"

# Silence MLflow's informational hint printed at import time
MLFLOW_DISABLE_AGENT_HINT=1
