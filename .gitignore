# ==========================================================
#  DATA: managed by DVC, never by Git
# ==========================================================
data/**
!data/**/
!data/**/.gitkeep
!data/**/*.dvc

# ==========================================================
#  MODELS AND ML ARTIFACTS: managed by MLflow / DVC
# ==========================================================
models/
*.pkl
*.joblib
*.h5
*.onnx
*.pt
*.pth
mlruns/
mlartifacts/
artifacts/
outputs/

# Generated reports (Evidently, CML, coverage)
reports/
*.html
!docs/**/*.html

# ==========================================================
#  SECRETS AND LOCAL CONFIGURATION
# ==========================================================
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.dvc/config.local

# ==========================================================
#  PYTHON
# ==========================================================
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# ==========================================================
#  QUALITY AND TEST TOOLS
# ==========================================================
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# ==========================================================
#  NOTEBOOKS
# ==========================================================
.ipynb_checkpoints/

# ==========================================================
#  INFRA: Terraform
# ==========================================================
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl.bak
crash.log

# ==========================================================
#  OS AND EDITORS
# ==========================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.log
